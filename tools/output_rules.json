{
  "$schema": "output_rules_v1",
  "description": "Ash Harbor WM/WSK 输出格式规则配置。修改格式时更新此文件，不需改脚本。",
  "wm": {
    "blocks": {
      "order": ["[Move]", "[Probability Check]", "[Resolution]", "[主要状态]"],
      "all_mandatory": true,
      "label_no_newline": true,
      "terminator": "[主要状态]"
    },
    "empty_formats": {
      "[Move]": "无",
      "[Probability Check]": "无概率事件",
      "[Resolution]": "无"
    },
    "block_rules": {
      "[Move]": {
        "format_pattern": "^\\[Move\\] (.+ -> .+ -> .+ \\| Steps: \\d+ \\| Travel Time: \\d+min|无)$",
        "format_desc": "[Move] Origin -> {Route} -> Destination | Steps: {N} | Travel Time: {N}min 或 [Move] 无"
      },
      "[Probability Check]": {
        "format_pattern": "^\\[Probability Check\\] (Trigger: .+；Base: \\d+；.*Result: .+；Outcome: .+|无概率事件)$",
        "format_desc": "[Probability Check] Trigger: {...}；Base: {N}；...；Result: {触发/未触发}；Outcome: {...} 或 无概率事件"
      },
      "[Resolution]": {
        "format_pattern": "^\\[Resolution\\] (消耗（D\\d+->D\\d+）: .+|获得: .+|无)$",
        "format_desc": "[Resolution] 消耗（D{prev}->D{curr}）: {物品×数量}；{类别}: {结果}（如 获得: {...}）或 [Resolution] 无",
        "consumption_pattern": "消耗（D\\d+->D\\d+）:",
        "separator": "；"
      },
      "[主要状态]": {
        "format_pattern": "^\\[主要状态\\] D\\d+-T\\d+ \\d{2}:\\d{2} \\| .+ \\| .+-.+-.+ \\| .+ \\| .+$",
        "format_desc": "[主要状态] D{Day}-T{Turn} {HH:MM} | {位置} | {Season}-{天气}-{气温} | {压力} | {风险}",
        "segments": 5
      }
    }
  },
  "wsk": {
    "header_pattern": "^\\[State Update\\] D\\d+-T\\d+$",
    "header_desc": "[State Update] D{day}-T{turn}",
    "header_segments": 1,
    "delta_keyword": "Inventory Delta:",
    "full_view_fields": 6,
    "full_view_field_names": [
      "Inventory State",
      "Party Condition",
      "Relationship & Threat",
      "Map Knowledge",
      "Base Structure State",
      "近五日主要事件"
    ]
  }
}
